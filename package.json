{
  "name": "streamhub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @streamhub/hub --filter @streamhub/dashboard --filter \"./modules/*\" --parallel --if-present run dev",
    "desktop:dev": "pnpm --filter @streamhub/desktop run dev",
    "desktop:build": "pnpm --filter @streamhub/desktop run build",
    "desktop:prepare": "pnpm build && node apps/desktop/scripts/prepare.mjs",
    "build": "pnpm --filter @streamhub/dashboard --filter \"./modules/*\" --if-present run build",
    "start": "pnpm --filter @streamhub/hub run start",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
