# Hub port (default 4747); overlay module pages are served on HUB_MODULES_PORT (default 4748)
HUB_PORT=
HUB_MODULES_PORT=
# OBS → Tools → WebSocket Server Settings (default ws://127.0.0.1:4455)
OBS_WS_URL=
OBS_WS_PASSWORD=
# Twitch app Client ID (Public client type) — see docs/setup/twitch.md
TWITCH_CLIENT_ID=
