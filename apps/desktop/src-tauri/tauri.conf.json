{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "streamhub",
  "version": "0.1.0",
  "identifier": "com.streamhub.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. desktop:prepare",
    "beforeBuildCommand": "pnpm --dir ../.. desktop:prepare",
    "frontendDist": "../resources/dashboard"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "window-drag",
          "description": "Lets the dashboard toolbar move and zoom the window; nothing else is exposed to the page.",
          "windows": ["main"],
          "remote": { "urls": ["http://127.0.0.1:*"] },
          "permissions": ["core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/streamhub-node"],
    "resources": {
      "../resources/": "resources/"
    },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
